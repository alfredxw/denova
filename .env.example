# Docker Compose environment. Copy to .env and edit; .env is gitignored.
# On Coolify, set these in the platform's environment panel instead.

# Login credentials for the web UI. Change before exposing the port.
DENOVA_REMOTE_ACCESS_USERNAME=admin
DENOVA_REMOTE_ACCESS_PASSWORD=change-me

# Host port when 8080 is taken (container stays on 8080).
# DENOVA_PORT=9000

# Keep enabled behind a reverse proxy (Coolify/Traefik/Nginx); remove when
# publishing the port directly without a proxy.
# DENOVA_TRUST_PROXY_HEADERS=true

# Optional model connection; configurable later in Settings.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://models.example.com/v1
# OPENAI_MODEL=my-model
