{
  "manifestVersion": 1,
  "id": "example.text-tools",
  "version": "1.2.0",
  "apiMajor": 1,
  "name": {
    "zh-CN": "创作工具箱",
    "en-US": "Creative Toolkit"
  },
  "description": {
    "zh-CN": "写作与游戏共用的插件示例：文本统计、批量文本整理、资料库检索、独立笔记和插图生成。演示工具、工具集、设置、权限、模型槽位和按会话隔离的数据。",
    "en-US": "A shared writing and game plugin: text statistics, batch cleanup, library search, private notes, and illustration generation. Demonstrates tools, toolsets, settings, permissions, model slots, and scoped data."
  },
  "development": {
    "build": {
      "command": "node",
      "args": [
        "--check",
        "server.mjs"
      ]
    }
  },
  "distribution": {
    "files": [
      "server.mjs",
      "runtime.mjs",
      "tools",
      "settings.schema.json",
      "defaults.toml",
      "locales",
      "tools.mjs"
    ]
  },
  "runtime": {
    "backend": {
      "protocol": "denova-runtime-v1",
      "launch": {
        "kind": "runtime",
        "runtime": "node",
        "entry": "server.mjs",
        "args": []
      }
    }
  },
  "permissions": {
    "required": [
      "tools.invoke",
      "pluginData"
    ],
    "optional": [
      "library.read",
      "images.generate",
      "tools.write"
    ]
  },
  "contributes": {
    "tools": [
      {
        "id": "count-characters",
        "definition": "tools/count.json",
        "endpoint": {
          "method": "POST",
          "path": "/tools/count"
        }
      },
      {
        "id": "clean-text",
        "definition": "tools/clean.json",
        "endpoint": {
          "method": "POST",
          "path": "/tools/clean"
        }
      },
      {
        "id": "read-notes",
        "definition": "tools/notes-read.json",
        "endpoint": {
          "method": "POST",
          "path": "/tools/notes-read"
        }
      },
      {
        "id": "save-note",
        "definition": "tools/notes-save.json",
        "endpoint": {
          "method": "POST",
          "path": "/tools/notes-save"
        }
      },
      {
        "id": "search-library",
        "definition": "tools/library.json",
        "endpoint": {
          "method": "POST",
          "path": "/tools/library"
        }
      },
      {
        "id": "illustrate",
        "definition": "tools/illustrate.json",
        "endpoint": {
          "method": "POST",
          "path": "/tools/illustrate"
        }
      }
    ],
    "toolsets": [
      {
        "id": "text-utils",
        "tools": [
          "count-characters",
          "clean-text"
        ]
      },
      {
        "id": "creative-resources",
        "tools": [
          "read-notes",
          "save-note",
          "search-library",
          "illustrate"
        ]
      }
    ]
  },
  "settings": {
    "schema": "settings.schema.json",
    "defaults": "defaults.toml"
  },
  "locales": {
    "zh-CN": "locales/zh-CN.json",
    "en-US": "locales/en-US.json"
  },
  "modelSlots": [
    {
      "id": "illustrator",
      "titleKey": "illustrator",
      "kind": "image",
      "required": false
    }
  ]
}
